{
  "name": "vorinthex-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "load-local-env": "bun run ../.github/scripts/write-local-env.ts dev backend backend/.env.local",
    "dev": "bun run load-local-env && bun --env-file=.env.local run --hot src/api/index.ts",
    "dev:infra": "docker compose up -d arangodb redis localstack mailpit",
    "dev:services": "docker compose --profile services up",
    "start": "bun run scripts/dev-start.ts",
    "start:server": "bun run load-local-env && bun --env-file=.env.local run src/api/index.ts",
    "start:app": "bun run load-local-env && bun --env-file=.env.local run src/api/index.ts",
    "start:render": "bun run load-local-env && bun --env-file=.env.local run src/render-worker/index.ts",
    "start:document-worker": "bun run load-local-env && bun --env-file=.env.local run src/document-worker/index.ts",
    "reset": "bun run scripts/reset.ts",
    "create:super-admin": "bun run scripts/create-super-admin.ts",
    "delete:account": "bun run scripts/delete-account.ts",
    "nodes": "bun run scripts/nodes.ts",
    "check": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:e2e:content": "bun run scripts/content-e2e.ts",
    "test:e2e:archive-api": "bun run load-local-env && bun --env-file=.env.local run scripts/archive-api-e2e.ts",
    "test:e2e:media-library": "bun run scripts/media-library-e2e.ts",
    "test:e2e:travel": "bun run load-local-env && bun --env-file=.env.local run scripts/travel-e2e.ts",
    "test:e2e:rag-live": "bun run scripts/rag-live-e2e.ts",
    "test:document-scan-live": "bun run scripts/document-scan-live.ts",
    "db:migrate": "bun run load-local-env && bun --env-file=.env.local src/db/arango-migrate.ts",
    "db:migrate:dev": "bun run load-local-env && bun --env-file=.env.local src/db/arango-migrate.ts",
    "db:migrate:ci": "bun run src/db/arango-migrate.ts",
    "db:backfill-semantic-embeddings": "bun run load-local-env && bun --env-file=.env.local scripts/backfill-semantic-embeddings.ts",
    "db:backfill-semantic-embeddings:ci": "bun run scripts/backfill-semantic-embeddings.ts",
    "seed.ts": "bun run load-local-env && bun --env-file=.env.local src/lib/db/seed.ts",
    "db:seed:ci": "bun run src/lib/db/seed.ts",
    "db:seed": "bun run load-local-env && bun --env-file=.env.local src/db/seed-all.ts",
    "seed:secrets": "bun run scripts/seed-secrets.ts",
    "seed:dev-archive": "bun run load-local-env && bun --env-file=.env.local run scripts/seed-dev-archive.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-bedrock-runtime": "3.1091.0",
    "@aws-sdk/client-ecs": "^3.1106.0",
    "@aws-sdk/client-s3": "3.1079.0",
    "@aws-sdk/client-textract": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "3.1079.0",
    "@google/generative-ai": "^0.24.1",
    "@otplib/plugin-base32-scure": "^13.4.1",
    "@otplib/plugin-crypto-noble": "^13.4.1",
    "@otplib/totp": "^13.4.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "@smithy/node-http-handler": "4.9.8",
    "@sparticuz/chromium": "^149.0.0",
    "arangojs": "^9.3.0",
    "bullmq": "^6.0.10",
    "cuid": "^3.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "ioredis": "^5.4.0",
    "mammoth": "^1.12.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.44.0",
    "otplib": "^13.4.1",
    "puppeteer-core": "^25.2.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "svix": "^1.96.1",
    "word-extractor": "^1.0.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/word-extractor": "^1.0.6",
    "typescript": "^5.7.0"
  }
}
