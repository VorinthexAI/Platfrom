# Caddy reverse proxy for the single-box early-infra app host.
# Rendered by deploy.sh with __COLOR__ replaced by the active color (blue|green).
#
# Cloudflare is the client (proxied). The apex serves the app and www redirects
# to it. Backend v1 API paths go to Bun (:3001), and all other paths go to Next.js.
#
# Serves the apex on :80 AND :443 with a self-signed internal certificate
# (Cloudflare "Full", non-strict). local_certs
# forces Caddy's internal CA so it never reaches out to Let's Encrypt.

{
	admin off
	local_certs
	servers {
		# https://www.cloudflare.com/ips-v4 and /ips-v6
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

(routes) {
	@api path /api/v1 /api/v1/*
	handle @api {
		reverse_proxy api-__COLOR__:3001 {
			# Send one verified address, never the caller's forwarded chain.
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web-__COLOR__:3000 {
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
		}
	}
}

http://vorinthex.com {
	redir https://vorinthex.com{uri} permanent
}

http://www.vorinthex.com {
	redir https://vorinthex.com{uri} permanent
}

https://www.vorinthex.com {
	tls internal
	redir https://vorinthex.com{uri} permanent
}

https://vorinthex.com {
	tls internal
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	import routes
}
