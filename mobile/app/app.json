{
  "expo": {
    "name": "Vorinthex AI",
    "slug": "vorinthex-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "vorinthexcore",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030507",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.vorinthex.com",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "associatedDomains": [
        "applinks:vorinthex.com"
      ]
    },
    "android": {
      "package": "app.vorinthex.com",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#030507",
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vorinthex.com",
              "path": "/open"
            },
            {
              "scheme": "https",
              "host": "vorinthex.com",
              "path": "/public/auth/token"
            },
            {
              "scheme": "https",
              "host": "vorinthex.com",
              "path": "/auth/mfa"
            },
            {
              "scheme": "https",
              "host": "vorinthex.com",
              "path": "/capability/signal"
            },
            {
              "scheme": "https",
              "host": "vorinthex.com",
              "pathPrefix": "/referral/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030507",
          "image": "./assets/brand/vorinthex-mark.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#FFFFFF",
          "defaultChannel": "default"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vorinthex access to your photo library so you can upload images to the app.",
          "cameraPermission": "Allow Vorinthex to scan documents and take photos for Gallery."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vorinthex to scan documents and capture images for Gallery.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@config-plugins/react-native-pdf",
      "@config-plugins/react-native-blob-util",
      "expo-asset",
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a9ba74e-cefe-49e6-9fd0-9b38a69c8d18"
      }
    },
    "owner": "vorinthex-ai"
  }
}
