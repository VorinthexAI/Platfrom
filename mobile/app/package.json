{
  "name": "vorinthex-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "load-local-env": "bun run ../../.github/scripts/write-local-env.ts dev mobile mobile/app/.env.local",
    "load-production-env": "bun run ../../.github/scripts/write-local-env.ts prod mobile mobile/app/.env.local",
    "start": "bun run load-local-env && expo start",
    "start:production": "bun run load-production-env && expo start",
    "android": "bun run load-local-env && expo run:android",
    "android:production": "bun run load-production-env && expo run:android",
    "ios": "bun run load-local-env && expo run:ios",
    "ios:production": "bun run load-production-env && expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "bun test src/lib/*.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-three/fiber": "^9",
    "@tanstack/react-query": "^5.90.0",
    "@vorinthex/shared": "workspace:*",
    "axios": "^1.18.1",
    "expo": "~57.0.6",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.5",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "three": "^0.180.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "^0.180.0",
    "typescript": "~6.0.3"
  }
}
